# Copy to .env alongside docker-compose.yml and fill in. .env is gitignored:
# TUNNEL_TOKEN is a credential and grants inbound access to this container.

# Required. The SEC requires a real contact address in the User-Agent header
# and returns 403 without one. Rate-limit complaints land here too.
SEC_CONTACT=you@example.com

# Required. Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel ->
# Install and run a connector -> copy the token out of the docker command.
TUNNEL_TOKEN=

# Host folder holding stocks.db, the EDGAR cache and run logs. Create it and
# copy stocks.db in before the first start.
DATA_DIR=/volume1/docker/stock-monitor/data

# Container timezone. Drives both the log timestamps and the cron schedule.
TZ=Asia/Singapore

# When the daily refresh runs, in TZ. The US close at 16:00 ET lands at
# 04:00-05:00 Singapore the next morning, so 06:00 local sits comfortably after
# the last session has settled and yfinance has caught up.
DAILY_CRON=0 6 * * *
